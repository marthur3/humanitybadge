{
  "manifest_version": 3,
  "name": "Humanitype - Verified Human Typing",
  "version": "1.0",
  "description": "Prove your comment is human-typed. Record, verify, and share a replay link — paste it anywhere as proof.",
  "homepage_url": "https://humanitype.netlify.app",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://is.gd/*",
    "https://jsonblob.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Humanitype"
  },
  "options_page": "settings.html",
  "web_accessible_resources": [
    {
      "resources": ["replay.html", "replay.js", "replay.css"],
      "matches": ["*://*/*"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
